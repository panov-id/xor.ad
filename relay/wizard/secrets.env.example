# Wizard secrets — copy to secrets.env and fill in. Never committed:
# relay/.gitignore excludes secrets.env, and this file must stay valueless.
#
# run.sh passes the whole file to the container (--env-file). The list here is
# the complete one on purpose: the previous list lived in a docstring, named
# about half of them, and the half it omitted included GITHUB_TOKEN — whose
# absence made a production deploy fail with an explanation that sent the
# operator to fix something else entirely.
#
# A "?" in a comment means optional.

# --- storage (Bunny Storage: panel users, waitlist, logs, audit) --------------
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_HOST=          # ? region host, when the zone is not on the default one

# --- mail (Resend) ------------------------------------------------------------
RESEND_API_KEY=
RESEND_KEYS=                 # ? per-brand keys, if a brand sends under its own
WELCOME_FROM=                # ? overrides the brand's own From for the welcome letter
PANEL_SENDER=                # ? From for panel sign-in and invitations

# --- dns (Bunny DNS: node records, DNS-01 for TLS) ----------------------------
BUNNY_API_KEY=

# --- provider (whichever creates the boxes) -----------------------------------
HETZNER_TOKEN=

# --- ssh ----------------------------------------------------------------------
SSH_PUBLIC_KEY=              # the key authorised on every box the wizard creates

# --- what the node itself needs ------------------------------------------------
# Signs panel sessions. One per environment and never shared: a single secret
# meant a token minted by the dev node verified on prod byte for byte, and dev
# is the environment with the weaker way in. Changing one logs that
# environment's operators out and nobody else. A missing one now stops the
# deploy instead of shipping a node whose panel rejects every sign-in.
SESSION_SECRET_DEV=
SESSION_SECRET_STAGING=
SESSION_SECRET_PROD=
POSTGRES_PASSWORD=
ORIGIN_TOKEN=                # what Caddy presents to the node, so origin is not open

# --- images (ghcr.io) ----------------------------------------------------------
GHCR_USER=
GHCR_TOKEN=

# --- production gate -----------------------------------------------------------
# Read access to the release repository, and only used when deploying a public
# env: the release check reads it. Without it a private repo answers 404, and a
# tag that IS published looks unpublished. Empty counts as absent — the wizard
# then says it could not check, rather than claiming the release is missing.
GITHUB_TOKEN=
