.idea/
# Generated visual-test output, not source
/testing/screenshots/
# Test runtime artifacts (created inside the Docker runners)
/testing/node_modules/
/testing/results/
/testing/report/
# Deploy secrets — real tokens/keys, never committed
/deploy/.env.deploy
/deploy/github-secrets.json
# Runtime artifact of deploy/setup-sosed-email.sh (Resend domain DNS payload)
/deploy/.sosed-resend-domain.json
# Byte-code left behind whenever a deploy helper is run or syntax-checked
__pycache__/

# Подписанные юридические документы провайдеров. Репозиторий публичный, а в
# договоре по ст. 28 стоят домашний адрес владельца, его почта и номер клиента —
# один git add -A, и это в истории навсегда (проверено 21.09.2026 при получении
# DPA Hetzner). Сами файлы лежат в docs/ на диске; в историю не идут.
docs/*.pdf
/depth/node_modules/
